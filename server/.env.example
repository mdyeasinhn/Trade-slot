# ---------------------------------------------------------------------------
# TradeSlot backend environment
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Comma-separated list of allowed browser origins for the web chat client.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Public base URL of this API (used to build Stripe return URLs).
API_BASE_URL=http://localhost:4000
# Public base URL of the web client (Stripe success/cancel redirects).
CLIENT_BASE_URL=http://localhost:3000

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tradeslot?schema=public

# --- Auth -------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Stripe -----------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# --- WhatsApp Cloud API -----------------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# --- Booking rules (minor currency units for money) -------------------------
JOB_DURATION_MINUTES=60
TRAVEL_BUFFER_MINUTES=30
BOOKING_FEE=5000
APPLICATION_FEE=500

# Default trader working window (local to the trader's timezone).
WORK_DAY_START=09:00
WORK_DAY_END=17:00
DEFAULT_TIMEZONE=UTC
